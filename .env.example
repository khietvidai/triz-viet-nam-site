# Astro standalone Node server (see astro.config.mjs)
HOST=0.0.0.0
PORT=4321

# DeepSeek API key — used by src/actions/index.ts
# Get one at https://platform.deepseek.com/api_keys
# Production: set with `wrangler secret put DEEPSEEK_API_KEY`
DEEPSEEK_API_KEY=

# Authentication & Video Member Area
# Production: set with `wrangler secret put SESSION_SECRET` & `ADMIN_SECRET`
SESSION_SECRET=
ADMIN_SECRET=

# Google OAuth 2.0 (Google / Gmail login)
# Production: set with `wrangler secret put GOOGLE_CLIENT_ID` & `GOOGLE_CLIENT_SECRET`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

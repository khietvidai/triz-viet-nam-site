---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
/// Import content data
import { getDictionary } from "../../lib/dictionary";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "vi" } }];
}

const { lang } = Astro.params;
const dict = await getDictionary(lang as "en" | "vi");

if (lang !== "en" && lang !== "vi") {
    return Astro.redirect("/en");
}

const title = lang === "vi" ? "Di sản TRIZ Việt Nam" : "TRIZ Vietnam Legacy";
---

<Layout title={title} lang={lang}>
    <Header lang={lang} />

    <main class="min-h-screen bg-white">
        <!-- Hero Section -->
        <section class="relative pt-40 pb-6 overflow-hidden">
            <div class="absolute inset-0 bg-orange-50/50 -z-10"></div>
            <div
                class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-100/40 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2"
            >
            </div>

            <div class="max-w-4xl mx-auto px-6 text-center">
                <h1
                    class="text-4xl md:text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-red-600 to-orange-600 mb-6 leading-tight"
                >
                    {
                        lang === "vi"
                            ? "Di sản TRIZ tại Việt Nam"
                            : "The Legacy of TRIZ in Vietnam"
                    }
                </h1>
                <p
                    class="text-xl text-gray-700 leading-relaxed max-w-2xl mx-auto"
                >
                    {
                        lang === "vi"
                            ? "Nơi lưu giữ và tri ân những cống hiến của Thầy Phan Dũng cùng các cộng sự."
                            : "Honoring the contributions of Associate Professor Phan Dung and his colleagues."
                    }
                </p>
                <!-- Future colleagues can be added here -->
            </div>
        </section>

        <section class="pt-6 pb-16 px-6 max-w-4xl mx-auto space-y-16">
            <!-- Tribute Card -->
            <div
                class="bg-white rounded-2xl p-8 md:p-12 shadow-xl shadow-red-900/5 border border-gray-100 flex flex-col md:flex-row gap-8 items-center group hover:shadow-2xl hover:shadow-red-900/10 transition-shadow duration-300"
            >
                <div class="flex-1 space-y-6">
                    <a
                        href={`/${lang}/phan-dung`}
                        class="group-hover:text-red-700 transition-colors"
                    >
                        <h2
                            class="text-3xl font-bold text-gray-900 group-hover:text-red-700 transition-colors"
                        >
                            {
                                lang === "vi"
                                    ? "Thầy Phan Dũng"
                                    : "Associate Professor Phan Dung"
                            }
                        </h2>
                    </a>
                    <div class="w-16 h-1 bg-red-600 rounded-full"></div>
                    <p
                        class="text-gray-700 leading-relaxed text-lg text-justify"
                    >
                        {
                            lang === "vi"
                                ? "Người đặt nền móng cho TRIZ tại Việt Nam. Với tâm huyết và trí tuệ, Thầy đã đưa Phương pháp luận Sáng tạo (TRIZ) đến gần hơn với hàng ngàn học sinh, sinh viên và các nhà nghiên cứu, khơi dậy niềm đam mê sáng tạo trong cộng đồng khoa học kỹ thuật nước nhà."
                                : "The founder of TRIZ in Vietnam. With dedication and wisdom, he brought the Theory of Inventive Problem Solving (TRIZ) to thousands of students and researchers, igniting a passion for creativity within the nation's scientific and technical community."
                        }
                    </p>
                    <p class="text-gray-600 italic">
                        {
                            lang === "vi"
                                ? '"Sáng tạo không phải là năng khiếu bẩm sinh huyền bí, mà là một khoa học có thể học tập và rèn luyện được."'
                                : '"Creativity is not a mystical innate talent, but a science that can be learned and practiced."'
                        }
                    </p>

                    <div class="pt-4">
                        <a
                            href={`/${lang}/phan-dung`}
                            class="inline-flex items-center gap-2 px-6 py-3 bg-red-50 text-red-700 rounded-full font-semibold hover:bg-red-100 transition-colors"
                        >
                            {
                                lang === "vi"
                                    ? "Xem tiểu sử & thành tựu"
                                    : "View Biography & Achievements"
                            }
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path d="M5 12h14"></path><path
                                    d="m12 5 7 7-7 7"></path></svg
                            >
                        </a>
                    </div>
                </div>
                <!-- Image -->
                <div class="w-full md:w-1/3 flex justify-center">
                    <a
                        href={`/${lang}/phan-dung`}
                        class="block relative w-80 h-80 rounded-full overflow-hidden shadow-2xl border-4 border-white group-hover:scale-105 transition-transform duration-500"
                    >
                        <img
                            src="/thay-phan-dung-triz.webp"
                            alt={lang === "vi"
                                ? "Thầy Phan Dũng"
                                : "Associate Professor Phan Dung"}
                            class="w-full h-full object-cover"
                        />
                    </a>
                </div>
            </div>

            <!-- Community Section at the Bottom -->
            <section
                class="py-16 px-6 max-w-4xl mx-auto border-t border-gray-100"
            >
                <div class="text-center space-y-8">
                    <h3 class="text-2xl font-bold text-gray-800">
                        {
                            lang === "vi"
                                ? "Sát Cánh Cùng Thầy"
                                : "Colleagues & Network"
                        }
                    </h3>
                    <p class="text-gray-600 max-w-2xl mx-auto">
                        {
                            lang === "vi"
                                ? "Sự nghiệp TRIZ tại Việt Nam không chỉ là nỗ lực của một cá nhân, mà là thành quả của cả một tập thể những người tâm huyết."
                                : "The TRIZ movement in Vietnam is not just the effort of one individual, but the fruit of a collective of dedicated people."
                        }
                    </p>

                    <!-- Colleague Card -->
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12 text-left"
                    >
                        <a
                            href={`/${lang}/thay-tran-the-huong`}
                            class="bg-gray-50 rounded-xl p-8 border border-gray-100 hover:border-red-200 transition-all flex items-center gap-4 group hover:shadow-lg"
                        >
                            <div
                                class="w-16 h-16 rounded-full overflow-hidden shrink-0 border-2 border-red-100 shadow-md group-hover:border-red-200 transition-colors"
                            >
                                <img
                                    src="/thay-tran-the-huong.webp"
                                    alt="Thầy Trần Thế Hưởng"
                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                                />
                            </div>
                            <div>
                                <h4
                                    class="text-xl font-bold text-gray-900 group-hover:text-red-700 transition-colors"
                                >
                                    Thầy Trần Thế Hưởng
                                </h4>
                                <p class="text-gray-600 text-sm">
                                    {
                                        lang === "vi"
                                            ? "Đồng sáng lập TSK"
                                            : "Co-founder of CSTC"
                                    }
                                </p>
                            </div>
                        </a>
                        <!-- Future colleagues can be added here -->
                    </div>
                </div>
            </section>

            <Footer lang={lang} />
        </section>
    </main>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import videoManifest from "../../Data/noibo_videos.json";
import principlesData from "../../Data/40principles_vi.json";
import {
    getNoiboEnv,
    getSessionUser,
    isUserAdmin,
    SESSION_COOKIE,
} from "../../lib/videoAuth";

const principleTitleById = new Map(
    principlesData.map((p) => [p.id, p.title])
);
const videos = videoManifest.map((video) => ({
    ...video,
    principles: (video.principleIds || []).map((id) => ({
        id,
        title: principleTitleById.get(id) ?? `Nguyên tắc ${id}`,
    })),
}));

export const prerender = false;

const { lang } = Astro.params;
if (lang !== "en" && lang !== "vi") {
    return Astro.redirect("/vi/noi-bo");
}

const env = getNoiboEnv(Astro.locals);
const user = await getSessionUser(
    env,
    Astro.cookies.get(SESSION_COOKIE)?.value
);
const isAdmin = isUserAdmin(user?.email);
const isApproved = Boolean(user && (isAdmin || user.approved === 1));

const err = Astro.url.searchParams.get("err");
const ERROR_MESSAGES: Record<string, string> = {
    auth: lang === "vi" ? "Có lỗi khi xác thực qua Google, vui lòng thử lại." : "Authentication error with Google, please try again.",
    login: lang === "vi" ? "Tài khoản hoặc mật khẩu không chính xác. Vui lòng kiểm tra lại." : "Incorrect account or password. Please try again.",
    missing: lang === "vi" ? "Vui lòng nhập đầy đủ tài khoản và mật khẩu." : "Please enter both username/email and password.",
    server: lang === "vi" ? "Có lỗi hệ thống, vui lòng thử lại sau." : "System error, please try again later.",
    forbidden: lang === "vi" ? "Bạn không có quyền truy cập trang quản trị." : "You do not have permission to access the admin page.",
};
const errorMessage = err ? (ERROR_MESSAGES[err] ?? ERROR_MESSAGES.server) : "";

const title = lang === "vi" ? "Video đào tạo nội bộ" : "Internal Training Videos";
---

<Layout title={title} lang={lang}>
    <Header lang={lang} />
    <main class="min-h-screen bg-gray-50 flex flex-col">
        <div class="flex-grow max-w-4xl mx-auto px-6 pt-24 pb-12 w-full">
            <!-- Header Hero -->
            <div class="text-center mb-10">
                <h1
                    class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-pink-600 mb-4"
                >
                    {title}
                </h1>
                <p class="text-gray-600 text-lg">
                    {lang === "vi"
                        ? "Trọn bộ video bài giảng về phương pháp luận TRIZ & 40 Nguyên tắc Sáng tạo."
                        : "Full video lectures on TRIZ Methodology & 40 Inventive Principles."}
                </p>
                <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-purple-50 border border-purple-200 px-4 py-1.5 text-sm font-semibold text-purple-700 shadow-sm">
                    <span>✨</span>
                    <span>
                        {lang === "vi"
                            ? "Video công khai & Bài 1–2 xem tự do • Liên hệ trizungdung2023@gmail.com để mở khóa trọn bộ"
                            : "Public videos & Lessons 1–2 are free • Contact trizungdung2023@gmail.com to unlock full course"}
                    </span>
                </div>
            </div>

            {
                errorMessage && (
                    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700 text-sm">
                        {errorMessage}
                    </div>
                )
            }

            {
                /* Khối đăng nhập (Tài khoản/Mật khẩu & Google OAuth) - chỉ hiện khi chưa đăng nhập */
                !user && (
                    <div id="login-box" class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 max-w-xl mx-auto mb-10 scroll-mt-24">
                        <div class="text-center mb-6">
                            <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center mx-auto mb-3 shadow-inner">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </div>
                            <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-1">
                                {lang === "vi" ? "Đăng nhập xem bài giảng nội bộ" : "Sign in to access lectures"}
                            </h2>
                            <p class="text-xs md:text-sm text-gray-500">
                                {lang === "vi"
                                    ? "Đăng nhập bằng tài khoản được cấp hoặc tài khoản Google để mở khóa trọn bộ video."
                                    : "Sign in with your assigned account or Google to unlock full lectures."}
                            </p>
                        </div>

                        {/* Form đăng nhập tài khoản & mật khẩu */}
                        <form method="POST" action="/api/noibo/login" class="space-y-4">
                            <input type="hidden" name="redirect" value={`/${lang}/noi-bo`} />
                            <div>
                                <label for="login-account" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                                    {lang === "vi" ? "Tài khoản hoặc Email" : "Username or Email"}
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </svg>
                                    </div>
                                    <input
                                        id="login-account"
                                        type="text"
                                        name="account"
                                        required
                                        autocomplete="username"
                                        placeholder={lang === "vi" ? "Ví dụ: chinhi hoặc email của bạn" : "e.g. chinhi or your email"}
                                        class="w-full rounded-xl border border-gray-300 pl-10 pr-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all bg-gray-50/50 hover:bg-white focus:bg-white"
                                    />
                                </div>
                            </div>

                            <div>
                                <label for="login-password" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                                    {lang === "vi" ? "Mật khẩu" : "Password"}
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                        </svg>
                                    </div>
                                    <input
                                        id="login-password"
                                        type="password"
                                        name="password"
                                        required
                                        autocomplete="current-password"
                                        placeholder="••••••••"
                                        class="w-full rounded-xl border border-gray-300 pl-10 pr-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition-all bg-gray-50/50 hover:bg-white focus:bg-white"
                                    />
                                </div>
                            </div>

                            <button
                                type="submit"
                                class="w-full py-3 px-5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-semibold shadow-sm hover:shadow-md transition-all flex items-center justify-center gap-2 group active:scale-[0.99]"
                            >
                                <span>{lang === "vi" ? "Đăng nhập bằng tài khoản" : "Sign in with Account"}</span>
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </button>
                        </form>

                        {/* Đường phân cách Hoặc */}
                        <div class="relative flex items-center justify-center my-6">
                            <div class="border-t border-gray-200 w-full"></div>
                            <span class="bg-white px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                {lang === "vi" ? "Hoặc" : "Or"}
                            </span>
                        </div>

                        {/* Đăng nhập bằng Google */}
                        <a
                            href={`/api/auth/google/login?redirect=/${lang}/noi-bo`}
                            class="inline-flex items-center justify-center gap-3 w-full py-3 px-5 rounded-xl border border-gray-300 bg-white hover:bg-gray-50 shadow-sm font-semibold text-gray-700 transition-all hover:shadow hover:border-gray-400 group mb-4"
                        >
                            <svg viewBox="0 0 48 48" width="20" height="20" class="flex-shrink-0">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.5 24c0-1.55-.15-3.24-.47-4.75H24v9.03h12.75c-.53 2.87-2.14 5.3-4.57 6.92l7.13 5.53C43.46 36.21 46.5 30.73 46.5 24z"/>
                                <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.13-5.53c-2.11 1.41-4.81 2.34-8.76 2.34-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            <span>{lang === "vi" ? "Đăng nhập nhanh bằng Google" : "Sign in with Google Account"}</span>
                        </a>

                        <div class="pt-3 border-t border-gray-100 text-center">
                            <p class="text-xs text-gray-500">
                                {lang === "vi"
                                    ? "✨ Video công khai & Bài 1–2 xem tự do. Khách hàng đã được cấp tài khoản nhập tài khoản & mật khẩu phía trên để mở khóa trọn bộ."
                                    : "✨ Public videos & Lessons 1–2 are free. Authorized members enter username & password above for full access."}
                            </p>
                        </div>
                    </div>
                )
            }

            {
                /* Thông tin thành viên khi đã đăng nhập */
                user && (
                    <div class="bg-white rounded-2xl shadow-sm border border-purple-100 p-4 md:p-5 mb-8">
                        <div class="flex items-center justify-between gap-4 flex-wrap">
                            <div class="flex items-center gap-3 md:gap-4">
                                {user.avatar_url ? (
                                    <img
                                        src={user.avatar_url}
                                        alt={user.name || user.email}
                                        class="w-12 h-12 rounded-full border-2 border-purple-200 shadow-sm"
                                        referrerpolicy="no-referrer"
                                    />
                                ) : (
                                    <div class="w-12 h-12 rounded-full bg-purple-100 text-purple-700 font-bold text-lg flex items-center justify-center border-2 border-purple-200">
                                        {(user.name || user.email).charAt(0).toUpperCase()}
                                    </div>
                                )}
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        {user.name && <span class="font-bold text-gray-900">{user.name}</span>}
                                        {isAdmin ? (
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-300">
                                                👑 Quản trị viên
                                            </span>
                                        ) : isApproved ? (
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
                                                Đã mở khóa toàn bộ ✅
                                            </span>
                                        ) : (
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                                                ⏳ Chờ duyệt kích hoạt
                                            </span>
                                        )}
                                    </div>
                                    <p class="text-xs text-gray-500 font-mono mt-0.5">
                                        {user.username ? (
                                            <span>
                                                <span class="font-semibold text-purple-700">@{user.username}</span>
                                                {user.email && !user.email.endsWith('@trizvietnam.com') && ` • ${user.email}`}
                                            </span>
                                        ) : (
                                            user.email
                                        )}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                {isAdmin && (
                                    <a
                                        href={`/${lang}/admin/users`}
                                        class="rounded-xl bg-purple-600 hover:bg-purple-700 text-white px-3.5 py-2 text-xs md:text-sm font-semibold transition-colors shadow-sm flex items-center gap-1.5"
                                    >
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                                        </svg>
                                        <span>Quản lý User</span>
                                    </a>
                                )}
                                <form method="POST" action="/api/noibo/logout">
                                    <button
                                        type="submit"
                                        class="rounded-xl border border-gray-300 px-3.5 py-2 text-xs md:text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 transition-colors"
                                    >
                                        {lang === "vi" ? "Đăng xuất" : "Sign Out"}
                                    </button>
                                </form>
                            </div>
                        </div>

                        {/* Hộp thông báo dành riêng cho user chưa được kích hoạt */}
                        {!isApproved && (
                            <div class="mt-4 pt-4 border-t border-amber-200/70 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 bg-amber-50/80 -mx-4 md:-mx-5 -mb-4 md:-mb-5 p-4 md:p-5 rounded-b-2xl">
                                <div class="flex items-start gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-amber-200/80 text-amber-800 flex items-center justify-center flex-shrink-0 mt-0.5">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    </div>
                                    <div>
                                        <h4 class="text-sm font-bold text-amber-950">
                                            Tài khoản của bạn đang chờ Admin duyệt mở khóa
                                        </h4>
                                        <p class="text-xs text-amber-800 mt-0.5">
                                            Bạn đang xem được <strong>Video công khai &amp; Bài 1, 2</strong>. Để mở khóa toàn bộ từ <strong>Bài 3 đến Bài 7</strong>, vui lòng liên hệ email: <a href="mailto:trizungdung2023@gmail.com" class="font-bold underline text-amber-950">trizungdung2023@gmail.com</a>.
                                        </p>
                                    </div>
                                </div>
                                <a
                                    href={`mailto:trizungdung2023@gmail.com?subject=${encodeURIComponent('Yêu cầu kích hoạt tài khoản xem video TRIZ')}&body=${encodeURIComponent(`Xin chào Admin,\nTôi đã đăng ký tài khoản trên website trizvietnam.com với email: ${user.email}.\nNhờ Admin kích hoạt giúp tôi quyền xem trọn bộ video bài giảng nội bộ.\nXin cảm ơn!`)}`}
                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold transition-colors shadow-sm whitespace-nowrap flex-shrink-0"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                    <span>Gửi email xin duyệt ngay</span>
                                </a>
                            </div>
                        )}
                    </div>
                )
            }

            <!-- Danh sách bài giảng -->
            <div class="space-y-6">
                {videos.map((video) => {
                    const isFree = Boolean((video as any).isFree || (video as any).isPublic);
                    const isPublic = Boolean((video as any).isPublic);
                    const canWatch = isFree || isApproved;

                    return (
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 transition-all hover:shadow-md">
                            <div class="flex items-center justify-between gap-4 mb-3 flex-wrap">
                                <div class="flex items-center gap-2.5">
                                    <span class="text-xl">
                                        {canWatch ? "▶️" : "🔒"}
                                    </span>
                                    <h3 class="text-xl font-bold text-gray-900">
                                        {video.title}
                                    </h3>
                                </div>
                                {isPublic ? (
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        {lang === "vi" ? "Công khai 🌐" : "Public 🌐"}
                                    </span>
                                ) : isFree ? (
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        {lang === "vi" ? "Xem tự do miễn phí 🎁" : "Free to watch 🎁"}
                                    </span>
                                ) : canWatch ? (
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-200">
                                        {lang === "vi" ? "Đã mở khóa ✅" : "Unlocked ✅"}
                                    </span>
                                ) : user ? (
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                        {lang === "vi" ? "Chờ duyệt kích hoạt ⏳" : "Pending approval ⏳"}
                                    </span>
                                ) : (
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-700 border border-gray-200">
                                        {lang === "vi" ? "Yêu cầu đăng ký 🔒" : "Sign in required 🔒"}
                                    </span>
                                )}
                            </div>

                            {video.principles.length > 0 ? (
                                <div class="flex flex-wrap gap-2 mb-4">
                                    {video.principles.map((p) => (
                                        <span class="px-3 py-1 bg-purple-50 text-purple-700 text-xs md:text-sm rounded-lg border border-purple-100 font-medium">
                                            {p.id}. {p.title}
                                        </span>
                                    ))}
                                </div>
                            ) : (
                                <div class="flex flex-wrap gap-2 mb-4">
                                    <span class="px-3 py-1 bg-indigo-50 text-indigo-700 text-xs md:text-sm rounded-lg border border-indigo-100 font-medium">
                                        🎯 {lang === "vi"
                                            ? ((video as any).tag || "Phương pháp luận & Kỹ năng phát biểu bài toán TRIZ")
                                            : ((video as any).tagEn || "TRIZ Methodology & Problem Formulation")}
                                    </span>
                                </div>
                            )}

                            {canWatch ? (
                                <div class="space-y-3">
                                    <video
                                        controls
                                        preload="metadata"
                                        class="w-full rounded-xl bg-black shadow aspect-video"
                                        src={`/api/noibo/video/${video.key}`}
                                    />
                                </div>
                            ) : user ? (
                                <div class="w-full aspect-video rounded-xl bg-gradient-to-br from-gray-900 via-gray-800 to-gray-950 flex flex-col items-center justify-center text-center p-6 border border-gray-700/60 shadow-inner">
                                    <div class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mb-3">
                                        <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                        </svg>
                                    </div>
                                    <h4 class="text-white font-bold text-base md:text-lg mb-1">
                                        {lang === "vi" ? "Tài khoản đang chờ duyệt mở khóa" : "Account Pending Approval"}
                                    </h4>
                                    <p class="text-gray-300 text-xs md:text-sm max-w-md mb-4">
                                        {lang === "vi"
                                            ? "Bài giảng này yêu cầu tài khoản đã được Admin duyệt. Vui lòng nhắn email tới trizungdung2023@gmail.com để được kích hoạt ngay."
                                            : "This lecture requires admin approval. Please contact trizungdung2023@gmail.com to activate your account."}
                                    </p>
                                    <a
                                        href={`mailto:trizungdung2023@gmail.com?subject=${encodeURIComponent('Yêu cầu kích hoạt tài khoản xem video TRIZ')}&body=${encodeURIComponent(`Xin chào Admin,\nTôi đã đăng ký tài khoản với email: ${user.email}.\nNhờ Admin kích hoạt giúp tôi mở khóa xem trọn bộ video TRIZ.\nXin cảm ơn!`)}`}
                                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs md:text-sm shadow transition-all hover:scale-[1.02]"
                                    >
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">

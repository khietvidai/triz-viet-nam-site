---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import videoManifest from "../../Data/noibo_videos.json";
import principlesData from "../../Data/40principles_vi.json";
import {
    getNoiboEnv,
    getSessionUser,
    SESSION_COOKIE,
} from "../../lib/videoAuth";

const principleTitleById = new Map(
    principlesData.map((p) => [p.id, p.title])
);
const videos = videoManifest.map((video) => ({
    ...video,
    principles: video.principleIds.map((id) => ({
        id,
        title: principleTitleById.get(id) ?? `Nguyên tắc ${id}`,
    })),
}));

export const prerender = false;

const { lang } = Astro.params;
if (lang !== "en" && lang !== "vi") {
    return Astro.redirect("/vi/noi-bo");
}

const env = getNoiboEnv(Astro.locals);
const user = await getSessionUser(
    env,
    Astro.cookies.get(SESSION_COOKIE)?.value
);

const err = Astro.url.searchParams.get("err");
const ok = Astro.url.searchParams.get("ok");

const ERROR_MESSAGES: Record<string, string> = {
    email: "Email không hợp lệ.",
    password: "Mật khẩu cần tối thiểu 8 ký tự.",
    exists: "Email này đã đăng ký rồi. Hãy đăng nhập.",
    login: "Email hoặc mật khẩu không đúng.",
    server: "Có lỗi hệ thống, vui lòng thử lại sau.",
};
const errorMessage = err ? (ERROR_MESSAGES[err] ?? ERROR_MESSAGES.server) : "";
const okMessage =
    ok === "registered"
        ? "Đăng ký thành công! Tài khoản của bạn đang chờ quản trị viên duyệt."
        : "";

const title = "Video đào tạo nội bộ";
---

<Layout title={title} lang={lang}>
    <Header lang={lang} />
    <main class="min-h-screen bg-gray-50 flex flex-col">
        <div class="flex-grow max-w-4xl mx-auto px-6 pt-24 pb-12 w-full">
            <div class="text-center mb-10">
                <h1
                    class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-pink-600 mb-4"
                >
                    {title}
                </h1>
                <p class="text-gray-600 text-lg">
                    Trọn bộ 7 bài giảng video về 40 Nguyên tắc Sáng tạo TRIZ.
                </p>
                <p
                    class="mt-3 inline-block rounded-full bg-purple-50 border border-purple-200 px-4 py-1.5 text-sm font-semibold text-purple-700"
                >
                    🔒 Chỉ thành viên đã đăng ký và được duyệt mới xem được
                    video
                </p>
            </div>

            {
                errorMessage && (
                    <p class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-700">
                        {errorMessage}
                    </p>
                )
            }
            {
                okMessage && (
                    <p class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-700">
                        {okMessage}
                    </p>
                )
            }

            {
                !user && (
                    <div class="mb-10">
                        <!-- Google OAuth Login Button -->
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 max-w-xl mx-auto mb-8 text-center">
                            <h2 class="text-xl font-bold text-gray-900 mb-2">
                                {lang === "vi" ? "Đăng nhập nhanh" : "Quick Sign In"}
                            </h2>
                            <p class="text-sm text-gray-500 mb-5">
                                {lang === "vi"
                                    ? "Sử dụng tài khoản Google để đăng nhập hoặc tạo tài khoản mới chỉ với 1 chạm"
                                    : "Use your Google account to sign in or create a new account in one click"}
                            </p>
                            <a
                                href={`/api/auth/google/login?redirect=/${lang}/noi-bo`}
                                class="inline-flex items-center justify-center gap-3 w-full py-3 px-5 rounded-xl border border-gray-300 bg-white hover:bg-gray-50 shadow-sm font-semibold text-gray-700 transition-all hover:shadow-md hover:border-gray-400 group"
                            >
                                <svg viewBox="0 0 48 48" width="22" height="22" class="flex-shrink-0">
                                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                    <path fill="#4285F4" d="M46.5 24c0-1.55-.15-3.24-.47-4.75H24v9.03h12.75c-.53 2.87-2.14 5.3-4.57 6.92l7.13 5.53C43.46 36.21 46.5 30.73 46.5 24z"/>
                                    <path fill="#FBBC05" d="M10.54 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.98-6.19z"/>
                                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.13-5.53c-2.11 1.41-4.81 2.34-8.76 2.34-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                </svg>
                                <span>{lang === "vi" ? "Đăng nhập bằng tài khoản Google" : "Sign in with Google Account"}</span>
                            </a>
                        </div>

                        <!-- Divider -->
                        <div class="flex items-center my-8 max-w-xl mx-auto">
                            <div class="flex-grow border-t border-gray-200"></div>
                            <span class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                {lang === "vi" ? "hoặc bằng email & mật khẩu" : "or with email & password"}
                            </span>
                            <div class="flex-grow border-t border-gray-200"></div>
                        </div>

                        <!-- Traditional Email / Password Forms -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <h2 class="text-xl font-bold text-gray-900 mb-4">
                                    {lang === "vi" ? "Đăng nhập" : "Sign In"}
                                </h2>
                                <form
                                    method="POST"
                                    action="/api/noibo/login"
                                    class="space-y-4"
                                >
                                    <input
                                        type="email"
                                        name="email"
                                        required
                                        placeholder="Email"
                                        class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                    />
                                    <input
                                        type="password"
                                        name="password"
                                        required
                                        placeholder={lang === "vi" ? "Mật khẩu" : "Password"}
                                        class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                    />
                                    <button
                                        type="submit"
                                        class="w-full rounded-lg bg-purple-600 px-4 py-2 font-semibold text-white hover:bg-purple-700 transition-colors"
                                    >
                                        {lang === "vi" ? "Đăng nhập" : "Sign In"}
                                    </button>
                                </form>
                            </div>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <h2 class="text-xl font-bold text-gray-900 mb-4">
                                    {lang === "vi" ? "Đăng ký" : "Sign Up"}
                                </h2>
                                <form
                                    method="POST"
                                    action="/api/noibo/register"
                                    class="space-y-4"
                                >
                                    <input
                                        type="email"
                                        name="email"
                                        required
                                        placeholder="Email"
                                        class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                    />
                                    <input
                                        type="password"
                                        name="password"
                                        required
                                        minlength="8"
                                        placeholder={lang === "vi" ? "Mật khẩu (tối thiểu 8 ký tự)" : "Password (min 8 chars)"}
                                        class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                    />
                                    <button
                                        type="submit"
                                        class="w-full rounded-lg bg-gray-800 px-4 py-2 font-semibold text-white hover:bg-gray-900 transition-colors"
                                    >
                                        {lang === "vi" ? "Đăng ký" : "Sign Up"}
                                    </button>
                                </form>
                                <p class="mt-3 text-sm text-gray-500">
                                    {lang === "vi"
                                        ? "Sau khi đăng ký, quản trị viên sẽ duyệt tài khoản trước khi bạn xem được video."
                                        : "After registering, an administrator will approve your account before you can watch videos."}
                                </p>
                            </div>
                        </div>
                    </div>
                )
            }

            {
                user && !user.approved && (
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center max-w-xl mx-auto mb-10">
                        <div class="flex flex-col items-center gap-3 mb-4">
                            {user.avatar_url ? (
                                <img
                                    src={user.avatar_url}
                                    alt={user.name || user.email}
                                    class="w-16 h-16 rounded-full border-2 border-purple-200 shadow-sm"
                                    referrerpolicy="no-referrer"
                                />
                            ) : (
                                <div class="w-16 h-16 rounded-full bg-purple-100 text-purple-700 text-xl font-bold flex items-center justify-center border-2 border-purple-200">
                                    {(user.name || user.email).charAt(0).toUpperCase()}
                                </div>
                            )}
                            <div>
                                {user.name && <h2 class="text-lg font-bold text-gray-900">{user.name}</h2>}
                                <p class="text-gray-600 text-sm"><code>{user.email}</code></p>
                            </div>
                        </div>

                        <div class="rounded-lg bg-amber-50 border border-amber-200 p-4 mb-6 text-amber-800 text-sm">
                            ⏳ <strong>Tài khoản đang chờ duyệt:</strong> Quản trị viên đang xem xét yêu cầu truy cập của bạn. Vui lòng quay lại sau khi tài khoản được kích hoạt.
                        </div>

                        <form method="POST" action="/api/noibo/logout">
                            <button
                                type="submit"
                                class="rounded-lg border border-gray-300 px-6 py-2 text-gray-700 hover:bg-gray-100 transition-colors text-sm font-medium"
                            >
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                )
            }

            {
                (!user || !user.approved) && (
                    <div class="mt-2">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 text-center">
                            Nội dung khóa học
                        </h2>
                        <div class="space-y-4">
                            {videos.map((video) => (
                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 opacity-90">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span>🔒</span>
                                        <h3 class="text-lg font-bold text-gray-900">
                                            {video.title}
                                        </h3>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {video.principles.map((p) => (
                                            <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full">
                                                {p.id}. {p.title}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                        <p class="mt-4 text-center text-sm text-gray-500">
                            Đăng ký tài khoản và chờ quản trị viên duyệt để mở
                            khóa toàn bộ video.
                        </p>
                    </div>
                )
            }

            {
                user && user.approved && (
                        <div class="flex items-center justify-between bg-white rounded-xl shadow-sm border border-gray-200 p-4">
                            <div class="flex items-center gap-3">
                                {user.avatar_url ? (
                                    <img
                                        src={user.avatar_url}
                                        alt={user.name || user.email}
                                        class="w-10 h-10 rounded-full border border-purple-200"
                                        referrerpolicy="no-referrer"
                                    />
                                ) : (
                                    <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-700 font-bold flex items-center justify-center">
                                        {(user.name || user.email).charAt(0).toUpperCase()}
                                    </div>
                                )}
                                <div>
                                    <div class="flex items-center gap-2">
                                        {user.name && <span class="font-bold text-gray-900">{user.name}</span>}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                            Đã kích hoạt ✅
                                        </span>
                                    </div>
                                    <p class="text-xs text-gray-500">{user.email}</p>
                                </div>
                            </div>
                            <form method="POST" action="/api/noibo/logout">
                                <button
                                    type="submit"
                                    class="rounded-lg border border-gray-300 px-4 py-1.5 text-sm text-gray-700 hover:bg-gray-100 transition-colors"
                                >
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                        {videos.map((video) => (
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <h2 class="text-xl font-bold text-gray-900 mb-2">
                                    {video.title}
                                </h2>
                                <div class="flex flex-wrap gap-2 mb-4">
                                    {video.principles.map((p) => (
                                        <span class="px-3 py-1 bg-purple-50 text-purple-700 text-sm rounded-full border border-purple-100">
                                            {p.id}. {p.title}
                                        </span>
                                    ))}
                                </div>
                                <video
                                    controls
                                    preload="metadata"
                                    class="w-full rounded-lg bg-black"
                                    src={`/api/noibo/video/${video.key}`}
                                />
                            </div>
                        ))}
                        <p class="text-sm text-gray-500">
                            Video chỉ dành cho đào tạo nội bộ, vui lòng không
                            chia sẻ ra ngoài.
                        </p>
                    </div>
                )
            }
        </div>

        <div class="mt-auto">
            <Footer lang={lang} />
        </div>
    </main>
</Layout>

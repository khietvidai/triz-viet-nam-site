---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import videoManifest from "../../Data/noibo_videos.json";
import principlesData from "../../Data/40principles_vi.json";
import {
    getNoiboEnv,
    getSessionUser,
    SESSION_COOKIE,
} from "../../lib/videoAuth";

const principleTitleById = new Map(
    principlesData.map((p) => [p.id, p.title])
);
const videos = videoManifest.map((video) => ({
    ...video,
    principles: video.principleIds.map((id) => ({
        id,
        title: principleTitleById.get(id) ?? `Nguyên tắc ${id}`,
    })),
}));

export const prerender = false;

const { lang } = Astro.params;
if (lang !== "en" && lang !== "vi") {
    return Astro.redirect("/vi/noi-bo");
}

const env = getNoiboEnv(Astro.locals);
const user = await getSessionUser(
    env,
    Astro.cookies.get(SESSION_COOKIE)?.value
);

const err = Astro.url.searchParams.get("err");
const ok = Astro.url.searchParams.get("ok");

const ERROR_MESSAGES: Record<string, string> = {
    email: "Email không hợp lệ.",
    password: "Mật khẩu cần tối thiểu 8 ký tự.",
    exists: "Email này đã đăng ký rồi. Hãy đăng nhập.",
    login: "Email hoặc mật khẩu không đúng.",
    server: "Có lỗi hệ thống, vui lòng thử lại sau.",
};
const errorMessage = err ? (ERROR_MESSAGES[err] ?? ERROR_MESSAGES.server) : "";
const okMessage =
    ok === "registered"
        ? "Đăng ký thành công! Tài khoản của bạn đang chờ quản trị viên duyệt."
        : "";

const title = "Video đào tạo nội bộ";
---

<Layout title={title} lang={lang}>
    <Header lang={lang} />
    <main class="min-h-screen bg-gray-50 flex flex-col">
        <div class="flex-grow max-w-4xl mx-auto px-6 pt-24 pb-12 w-full">
            <div class="text-center mb-10">
                <h1
                    class="text-4xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-purple-600 to-pink-600 mb-4"
                >
                    {title}
                </h1>
                <p class="text-gray-600 text-lg">
                    Trọn bộ 7 bài giảng video về 40 Nguyên tắc Sáng tạo TRIZ.
                </p>
                <p
                    class="mt-3 inline-block rounded-full bg-purple-50 border border-purple-200 px-4 py-1.5 text-sm font-semibold text-purple-700"
                >
                    🔒 Chỉ thành viên đã đăng ký và được duyệt mới xem được
                    video
                </p>
            </div>

            {
                errorMessage && (
                    <p class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-700">
                        {errorMessage}
                    </p>
                )
            }
            {
                okMessage && (
                    <p class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-700">
                        {okMessage}
                    </p>
                )
            }

            {
                !user && (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                            <h2 class="text-xl font-bold text-gray-900 mb-4">
                                Đăng nhập
                            </h2>
                            <form
                                method="POST"
                                action="/api/noibo/login"
                                class="space-y-4"
                            >
                                <input
                                    type="email"
                                    name="email"
                                    required
                                    placeholder="Email"
                                    class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                />
                                <input
                                    type="password"
                                    name="password"
                                    required
                                    placeholder="Mật khẩu"
                                    class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                />
                                <button
                                    type="submit"
                                    class="w-full rounded-lg bg-purple-600 px-4 py-2 font-semibold text-white hover:bg-purple-700 transition-colors"
                                >
                                    Đăng nhập
                                </button>
                            </form>
                        </div>
                        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                            <h2 class="text-xl font-bold text-gray-900 mb-4">
                                Đăng ký
                            </h2>
                            <form
                                method="POST"
                                action="/api/noibo/register"
                                class="space-y-4"
                            >
                                <input
                                    type="email"
                                    name="email"
                                    required
                                    placeholder="Email"
                                    class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                />
                                <input
                                    type="password"
                                    name="password"
                                    required
                                    minlength="8"
                                    placeholder="Mật khẩu (tối thiểu 8 ký tự)"
                                    class="w-full rounded-lg border border-gray-300 px-4 py-2"
                                />
                                <button
                                    type="submit"
                                    class="w-full rounded-lg bg-gray-800 px-4 py-2 font-semibold text-white hover:bg-gray-900 transition-colors"
                                >
                                    Đăng ký
                                </button>
                            </form>
                            <p class="mt-3 text-sm text-gray-500">
                                Sau khi đăng ký, quản trị viên sẽ duyệt tài
                                khoản trước khi bạn xem được video.
                            </p>
                        </div>
                    </div>
                )
            }

            {
                user && !user.approved && (
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
                        <p class="text-lg text-gray-700 mb-2">
                            Xin chào <strong>{user.email}</strong>
                        </p>
                        <p class="text-gray-600 mb-6">
                            ⏳ Tài khoản của bạn đang chờ quản trị viên duyệt.
                            Vui lòng quay lại sau.
                        </p>
                        <form method="POST" action="/api/noibo/logout">
                            <button
                                type="submit"
                                class="rounded-lg border border-gray-300 px-6 py-2 text-gray-700 hover:bg-gray-100 transition-colors"
                            >
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                )
            }

            {
                (!user || !user.approved) && (
                    <div class="mt-2">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4 text-center">
                            Nội dung khóa học
                        </h2>
                        <div class="space-y-4">
                            {videos.map((video) => (
                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 opacity-90">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span>🔒</span>
                                        <h3 class="text-lg font-bold text-gray-900">
                                            {video.title}
                                        </h3>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {video.principles.map((p) => (
                                            <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full">
                                                {p.id}. {p.title}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                        <p class="mt-4 text-center text-sm text-gray-500">
                            Đăng ký tài khoản và chờ quản trị viên duyệt để mở
                            khóa toàn bộ video.
                        </p>
                    </div>
                )
            }

            {
                user && user.approved && (
                    <div class="space-y-8">
                        <div class="flex items-center justify-between">
                            <p class="text-gray-700">
                                Xin chào <strong>{user.email}</strong> ✅
                            </p>
                            <form method="POST" action="/api/noibo/logout">
                                <button
                                    type="submit"
                                    class="rounded-lg border border-gray-300 px-4 py-1.5 text-sm text-gray-700 hover:bg-gray-100 transition-colors"
                                >
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                        {videos.map((video) => (
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                                <h2 class="text-xl font-bold text-gray-900 mb-2">
                                    {video.title}
                                </h2>
                                <div class="flex flex-wrap gap-2 mb-4">
                                    {video.principles.map((p) => (
                                        <span class="px-3 py-1 bg-purple-50 text-purple-700 text-sm rounded-full border border-purple-100">
                                            {p.id}. {p.title}
                                        </span>
                                    ))}
                                </div>
                                <video
                                    controls
                                    preload="metadata"
                                    class="w-full rounded-lg bg-black"
                                    src={`/api/noibo/video/${video.key}`}
                                />
                            </div>
                        ))}
                        <p class="text-sm text-gray-500">
                            Video chỉ dành cho đào tạo nội bộ, vui lòng không
                            chia sẻ ra ngoài.
                        </p>
                    </div>
                )
            }
        </div>

        <div class="mt-auto">
            <Footer lang={lang} />
        </div>
    </main>
</Layout>

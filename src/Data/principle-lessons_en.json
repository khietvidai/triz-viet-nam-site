[
  {
    "id": 1,
    "title": "Segmentation",
    "lecture": {
      "summary": "Segmentation means dividing an object into independent parts, making it sectional, and increasing the degree of division. The finer the division, the more flexible the system and the easier it is to control locally.",
      "body": [
        "Core idea: a solid monolith is rigid and structurally complete, but inflexible. Splitting it into independent parts trades some of that integrity for the ability to replace, transport and adjust each part on its own.",
        "Three escalating levels: (a) divide into independent parts; (b) make the object sectional or easy to assemble and disassemble; (c) increase segmentation to its limit — move to granules, fibres, powder or liquid.",
        "Signals to reach for this principle: the object is too large or heavy to handle; a failure in one spot forces replacement of the whole; size or shape must change with the situation.",
        "Known limits: segmentation multiplies joints, which raises assembly cost and introduces leak or loosening risks at each connection. Decide deliberately where to stop."
      ]
    },
    "cases": [
      {
        "title": "Moving structural steel into a constrained site",
        "context": "A single 12-metre steel beam could not reach a site accessible only through a narrow inner-city lane.",
        "contradiction": "The beam must be long to carry the load, yet length is exactly what makes it impossible to deliver.",
        "application": "Split the beam into shorter flanged sections bolted together on site.",
        "outcome": "Delivered by small truck and erected without a large crane, at the cost of rigorous inspection of every bolted joint."
      }
    ],
    "illustrations": [
      {
        "title": "From a bar of soap to liquid hand wash",
        "problem": "A shared bar of soap turns soggy, spreads germs and cannot be dosed.",
        "principleApplied": "Segmentation taken to its limit — a solid monolith becomes a liquid.",
        "solution": "Pump-dosed liquid soap delivers exactly the amount needed, and no user touches what remains."
      }
    ]
  },
